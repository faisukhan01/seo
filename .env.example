# ─── SEO Autopilot — environment variables ──────────────────────────────
# Copy the values below into Vercel → Project → Settings → Environment Variables
# (or a local .env file). Variables marked REQUIRED are needed for the core
# audit engine; the rest enable optional features.

# ── REQUIRED — database (Prisma / SQLite) ────────────────────────────────
# Local sandbox / self-hosted (persistent file):
DATABASE_URL="file:/home/z/my-project/db/custom.db"
# On Vercel the filesystem is read-only except /tmp, so use:
# DATABASE_URL="file:/tmp/seo-autopilot.db"
# NOTE: /tmp is ephemeral per serverless instance — audit history will not
# persist. The audit itself works regardless (history failures are ignored).
# For persistent history on Vercel, switch Prisma to a hosted provider
# (e.g. Turso/Postgres) and point DATABASE_URL at it.

# ── OPTIONAL — AI features (meta rewrites, keywords, briefs, schema,
#    summaries, Next.js code fixes). The audit/scoring engine does NOT
#    need these. ─────────────────────────────────────────────────────────
# The z-ai-web-dev-sdk reads a `.z-ai-config` file, not env vars. The build
# (scripts/write-zai-config.mjs) writes that file FROM these variables, so
# set either ZAI_CONFIG_JSON, or BOTH ZAI_BASE_URL and ZAI_API_KEY:
#
# Option A — single JSON variable (recommended; supports all SDK fields):
# ZAI_CONFIG_JSON={"baseUrl":"https://api.z.ai/api/paas/v4","apiKey":"sk-your-zai-key"}
# The SDK also accepts optional extra fields inside ZAI_CONFIG_JSON:
#   "token"   → sent as X-Token header
#   "chatId"  → sent as X-Chat-Id header
#   "userId"  → sent as X-User-Id header
#
# Option B — two variables (writes {baseUrl, apiKey} only):
ZAI_BASE_URL="https://api.z.ai/api/paas/v4"
ZAI_API_KEY="sk-your-zai-key"
#
# Get an API key at https://z.ai (API keys section).

# ── OPTIONAL — misc ──────────────────────────────────────────────────────
# Canonical site URL if you self-host and want correct absolute metadata:
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# ── Runtime metadata (set automatically by the platform — do not edit) ──
NODE_ENV="production"
